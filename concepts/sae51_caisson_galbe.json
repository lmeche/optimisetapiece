{
  "nom": "Caisson galbé (idée d'Iwan, joues triangulaires)",
  "description": "Poutre-caisson à hauteur variable : une tôle A pliée (dos vissé, dessus en quatre facettes qui suivent un profil galbé, face d'appui horizontale) et une tôle B pliée en U (deux joues triangulaires, semelle droite qui remonte du pied du dos jusque sous l'appui). Le dessus est le tirant, la semelle la bielle, les joues portent le cisaillement dans leur plan. Le profil (trois hauteurs) et les poches des joues et du dos sont réglés par l'optimiseur.",
  "variables": {
    "t_A": {
      "type": "epaisseur"
    },
    "t_B": {
      "type": "epaisseur"
    },
    "ecart_vis": {
      "type": "choix",
      "valeurs": [
        0,
        20,
        40,
        60
      ]
    },
    "u_b": {
      "type": "fraction"
    },
    "z_haut": {
      "type": "reel",
      "min": 100,
      "max": 210
    },
    "u_bas": {
      "type": "fraction"
    },
    "u_c": {
      "type": "fraction"
    },
    "x_ap": {
      "type": "reel",
      "min": 150,
      "max": 280
    },
    "x_end": {
      "type": "reel",
      "min": 300,
      "max": 350
    },
    "u_h1": {
      "type": "fraction"
    },
    "u_h2": {
      "type": "fraction"
    },
    "u_h3": {
      "type": "fraction"
    },
    "m_joue": {
      "type": "evidement",
      "tole": "B",
      "max": 60
    },
    "m_dos": {
      "type": "evidement",
      "tole": "A",
      "max": 50
    }
  },
  "derivees": {
    "xd": "X_FACE + t_A / 2",
    "b_min": "max(2 * ecart_vis + 2 * 12 + t_A, 44)",
    "b": "b_min + u_b * (2 * Y_MAX - 10 - t_B - b_min)",
    "z_bas": "10 + u_bas * (min(70, z_haut - 80) - 10)",
    "zc": "z_bas + 40 + u_c * (z_haut + 20 - z_bas - 40)",
    "h0": "z_haut - z_bas",
    "dzc": "zc - z_bas",
    "ls": "x_end - xd",
    "h_ap": "dzc * (x_end - x_ap) / ls",
    "x1": "xd + (x_ap - xd) / 4",
    "x2": "xd + (x_ap - xd) / 2",
    "x3": "xd + 3 * (x_ap - xd) / 4",
    "z1": "z_bas + dzc * (x1 - xd) / ls + (h0 + (h_ap - h0) * 0.25) * (0.5 + 1.5 * u_h1)",
    "z2": "z_bas + dzc * (x2 - xd) / ls + (h0 + (h_ap - h0) * 0.5) * (0.5 + 1.5 * u_h2)",
    "z3": "z_bas + dzc * (x3 - xd) / ls + (h0 + (h_ap - h0) * 0.75) * (0.5 + 1.5 * u_h3)"
  },
  "toles": [
